{
  "expo": {
    "name": "watch Later",
    "slug": "watch-later",
    "scheme": "watchlater",
    "version": "1.0.5",
    "orientation": "portrait",
    "backgroundColor": "#070312",
    "androidStatusBar": {
      "backgroundColor": "#070312",
      "barStyle": "light-content"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.watchlater.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.watchlater.app",
      "versionCode": 9,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070312"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/ic_stat_watch_later_96.png",
          "color": "#8614D9",
          "sounds": [
            "./assets/wl_now_showing.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#070312",
          "dark": {
            "image": "./assets/splash-blank.png",
            "backgroundColor": "#070312"
          },
          "android": {
            "backgroundColor": "#070312"
          }
        }
      ],
      "expo-web-browser",
      "./plugins/withReleaseDayDrawables.js",
      "./plugins/withNotifeeRepo.js",
      "./plugins/withReleaseSigning.js",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.facebook.proguard.annotations.** { *; }\n-keep class com.facebook.react.bridge.** { *; }\n-keep class com.facebook.react.uimanager.** { *; }\n-keep class com.facebook.hermes.unicode.** { *; }\n-keep class app.notifee.** { *; }\n-dontwarn app.notifee.**\n-keep class com.horcrux.svg.** { *; }\n-dontwarn com.horcrux.svg.**\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.swmansion.screens.** { *; }\n-keep class com.th3rdwave.safeareacontext.** { *; }\n-keep class com.facebook.react.modules.** { *; }\n-keep class com.google.firebase.messaging.** { *; }\n-dontwarn com.google.firebase.**\n-dontwarn com.google.android.gms.**\n-keep class com.google.android.gms.** { *; }"
          }
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save your Creator Studio posts",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bd40cd9-2078-4894-937d-fa20a0fe376e"
      }
    },
    "owner": "testbot0007"
  }
}
